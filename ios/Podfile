platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Automatically configures the "Which Locker Room?" app display name and embeds the
# LockerRoomWidgetExtension WidgetKit target into Runner.xcodeproj during `pod install`.
def configure_which_locker_room_widget_target!
  require 'xcodeproj'

  runner_info_plist = File.expand_path('Runner/Info.plist', __dir__)
  if File.exist?(runner_info_plist)
    plist_content = File.read(runner_info_plist)
    plist_content.gsub!(
      /<key>CFBundleDisplayName<\/key>\s*<string>[^<]*<\/string>/m,
      "<key>CFBundleDisplayName</key>\n\t<string>Which Locker Room?</string>"
    )
    plist_content.gsub!(
      /<key>CFBundleName<\/key>\s*<string>[^<]*<\/string>/m,
      "<key>CFBundleName</key>\n\t<string>Which Locker Room?</string>"
    )
    File.write(runner_info_plist, plist_content)
  end

  project_path = File.expand_path('Runner.xcodeproj', __dir__)
  return unless File.exist?(project_path)

  project = Xcodeproj::Project.open(project_path)
  runner_target = project.targets.find { |t| t.name == 'Runner' }
  return unless runner_target

  runner_dev_team = nil
  runner_bundle_id = 'com.makeshiftlabs.sharksIceLockerWidget'

  runner_target.build_configurations.each do |config|
    s = config.build_settings
    if s['DEVELOPMENT_TEAM'] && !s['DEVELOPMENT_TEAM'].to_s.strip.empty?
      runner_dev_team ||= s['DEVELOPMENT_TEAM']
    end
    if s['PRODUCT_BUNDLE_IDENTIFIER'] && !s['PRODUCT_BUNDLE_IDENTIFIER'].to_s.strip.empty?
      runner_bundle_id = s['PRODUCT_BUNDLE_IDENTIFIER']
    end
    s['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    s['CODE_SIGN_ENTITLEMENTS'] = 'Runner/Runner.entitlements'
    s['ASSETCATALOG_COMPILER_APPICON_NAME'] = 'AppIcon'
    s['PODS_ROOT'] = '$(SRCROOT)/Pods'
    s['PODS_PODFILE_DIR_PATH'] = '$(SRCROOT)'
  end

  widget_target_name = 'LockerRoomWidgetExtension'
  widget_target = project.targets.find { |t| t.name == widget_target_name }
  unless widget_target
    widget_target = project.new_target(:app_extension, widget_target_name, :ios, '16.0')
  end

  # Ensure Profile configuration exists on widget_target to match Flutter's Debug/Release/Profile
  unless widget_target.build_configuration_list['Profile']
    release_cfg = widget_target.build_configuration_list['Release']
    profile_cfg = project.new(Xcodeproj::Project::Object::XCBuildConfiguration)
    profile_cfg.name = 'Profile'
    profile_cfg.build_settings = Marshal.load(Marshal.dump(release_cfg.build_settings))
    widget_target.build_configuration_list.build_configurations << profile_cfg
  end

  # Ensure LockerRoomWidget group and source files are attached
  widget_group = project.main_group.find_subpath('LockerRoomWidget', true)
  widget_group.set_source_tree('<group>')
  widget_group.set_path('LockerRoomWidget')

  swift_ref = widget_group.files.find { |f| f.path == 'LockerRoomWidget.swift' } ||
              widget_group.new_file('LockerRoomWidget.swift')
  unless widget_group.files.find { |f| f.path == 'Info.plist' }
    widget_group.new_file('Info.plist')
  end
  unless widget_group.files.find { |f| f.path == 'LockerRoomWidget.entitlements' }
    widget_group.new_file('LockerRoomWidget.entitlements')
  end

  unless widget_target.source_build_phase.files_references.include?(swift_ref)
    widget_target.source_build_phase.add_file_reference(swift_ref, true)
  end

  ['WidgetKit', 'SwiftUI'].each do |fw|
    widget_target.add_system_framework(fw)
  end

  widget_bundle_id = "#{runner_bundle_id}.LockerRoomWidget"
  widget_target.build_configurations.each do |config|
    s = config.build_settings
    s['PRODUCT_NAME'] = '$(TARGET_NAME)'
    s['PRODUCT_BUNDLE_IDENTIFIER'] = widget_bundle_id
    s['INFOPLIST_FILE'] = 'LockerRoomWidget/Info.plist'
    s['CODE_SIGN_ENTITLEMENTS'] = 'LockerRoomWidget/LockerRoomWidget.entitlements'
    s['CODE_SIGN_STYLE'] = 'Automatic'
    if runner_dev_team && !runner_dev_team.to_s.strip.empty?
      s['DEVELOPMENT_TEAM'] = runner_dev_team
    end
    s['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    s['SWIFT_VERSION'] = '5.0'
    s['TARGETED_DEVICE_FAMILY'] = '1,2'
    s['LD_RUNPATH_SEARCH_PATHS'] = '$(inherited) @executable_path/Frameworks @executable_path/../../Frameworks'
    s['SKIP_INSTALL'] = 'YES'
    s['GENERATE_INFOPLIST_FILE'] = 'NO'
    s['CURRENT_PROJECT_VERSION'] = '1'
    s['MARKETING_VERSION'] = '1.0.0'
    s['CLANG_ENABLE_MODULES'] = 'YES'
    s['SWIFT_OPTIMIZATION_LEVEL'] = (config.name == 'Debug' ? '-Onone' : '-O')
  end

  unless runner_target.dependency_for_target(widget_target)
    runner_target.add_dependency(widget_target)
  end

  embed_phase = runner_target.copy_files_build_phases.find do |p|
    p.name == 'Embed Foundation Extensions' || p.symbol_dst_subfolder_spec == :plug_ins
  end
  unless embed_phase
    embed_phase = runner_target.new_copy_files_build_phase('Embed Foundation Extensions')
    embed_phase.symbol_dst_subfolder_spec = :plug_ins
  end

  appex_ref = widget_target.product_reference
  unless embed_phase.files_references.include?(appex_ref)
    build_file = embed_phase.add_file_reference(appex_ref, true)
    build_file.settings = { 'ATTRIBUTES' => ['RemoveHeadersOnCopy', 'CodeSignOnCopy'] }
  end

  # Place Embed Foundation Extensions BEFORE Thin Binary to avoid Xcode build cycle errors
  thin_idx = runner_target.build_phases.index { |p| p.respond_to?(:name) && p.name == 'Thin Binary' }
  embed_idx = runner_target.build_phases.index(embed_phase)
  if thin_idx && embed_idx && embed_idx > thin_idx
    runner_target.build_phases.delete(embed_phase)
    runner_target.build_phases.insert(thin_idx, embed_phase)
  end

  project.save
end

configure_which_locker_room_widget_target!

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
